{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r2cuerdame/capturepack/shared/protocol/protocol-v1.schema.json",
  "title": "CapturePack Protocol v1 message",
  "type": "object",
  "required": ["type", "protocol", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dom.element.selected",
        "tab.updated",
        "url.changed",
        "host.hello",
        "picker.armed",
        "picker.disarmed",
        "picker.failed"
      ]
    },
    "protocol": { "const": 1 },
    "timestamp": { "type": "number", "description": "Milliseconds, sender-relative" },
    "tab": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["url", "title"]
    },
    "element": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "id": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string", "maxLength": 200 },
        "selector": { "type": "string" },
        "bounds": {
          "type": "object",
          "description": "Viewport CSS pixels, as the page measures itself. Frame-local rectangles are translated into the TOP frame's viewport before being sent.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "required": ["x", "y", "width", "height"]
        },
        "frameDepth": {
          "type": "integer",
          "minimum": 0,
          "description": "How many nested browsing contexts the element sits below the top document. 0 for the top frame. Present from extension 0.1.9."
        }
      },
      "required": ["tag", "selector", "bounds"]
    },
    "viewport": {
      "type": "object",
      "description": "Where the page's coordinate space is. Required to place an element on a snapshot; sent by extension 0.1.4 and newer.",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "dpr": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 },
        "screenX": { "type": ["number", "null"] },
        "screenY": { "type": ["number", "null"] },
        "outerWidth": { "type": ["number", "null"] },
        "outerHeight": { "type": ["number", "null"] }
      },
      "required": ["width", "height", "dpr"]
    },
    "reason": {
      "type": "string",
      "maxLength": 200,
      "description": "Why picker.failed happened: a restricted page, no tab, or an injection error."
    },
    "app": { "type": "string" },
    "version": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "required": ["type"],
        "properties": { "type": { "const": "dom.element.selected" } }
      },
      "then": { "required": ["tab", "element", "viewport"] }
    },
    {
      "if": {
        "required": ["type"],
        "properties": { "type": { "enum": ["tab.updated", "url.changed"] } }
      },
      "then": { "required": ["tab"] }
    },
    {
      "if": {
        "required": ["type"],
        "properties": { "type": { "const": "picker.failed" } }
      },
      "then": { "required": ["reason"] }
    }
  ]
}
