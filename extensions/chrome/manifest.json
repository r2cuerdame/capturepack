{
  "manifest_version": 3,
  "name": "CapturePack",
  "description": "Sends DOM context to the CapturePack app: the element you pick, and the interface it sat in. Part of CapturePack, not a separate product.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CapturePack: pick an element",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
