{
  "name": "capturepack",
  "productName": "CapturePack",
  "version": "0.3.0",
  "description": "Rewind recent screen activity, pick captured UI objects, and save structured local evidence for humans and AI.",
  "license": "MIT",
  "author": "r2cuerdame",
  "homepage": "https://capturepack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/r2cuerdame/capturepack.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "check:sync": "node scripts/surface-sync-check.mjs",
    "check:delta": "node scripts/surface-delta-check.mjs",
    "check:ring-prune": "node scripts/ring-prune-check.mjs",
    "check:surface-restore": "node scripts/surface-restore-check.mjs",
    "check:provider-host": "node scripts/provider-host-check.mjs",
    "check:dom": "node scripts/dom-provider-check.mjs",
    "check:controls": "node scripts/control-lane-check.mjs",
    "check:context-host-dirty": "node scripts/context-host-dirty-check.mjs",
    "check:identity": "node scripts/pack-identity-check.mjs",
    "check:keyframes": "node scripts/keyframe-check.mjs",
    "check:pick": "node scripts/control-pick-check.mjs",
    "check:numbering": "node scripts/numbering-check.mjs",
    "check:motion": "node scripts/box-motion-check.mjs",
    "check:render": "node scripts/track-render-check.mjs",
    "check:trim": "node scripts/trim-drag-check.mjs",
    "check:plugins": "node scripts/plugin-preservation-check.mjs",
    "check:past": "node scripts/past-picking-check.mjs",
    "check:windows-context": "node scripts/windows-context-timeline-check.mjs",
    "check:image-context": "node scripts/image-context-check.mjs",
    "check:image-region-selector": "node scripts/image-region-selector-check.mjs",
    "check:image-desktop": "node scripts/image-desktop-check.mjs",
    "check:image-flow": "node scripts/image-flow-contract-check.mjs",
    "check:image-pack": "node scripts/image-pack-check.mjs",
    "check:image-pack-writer": "node scripts/image-pack-writer-check.mjs",
    "check:mcp-image-pack": "node scripts/mcp-image-pack-check.mjs",
    "check:repo-hygiene": "node scripts/repo-hygiene-check.mjs",
    "check:recorder-ring": "node scripts/recorder-ring-check.mjs",
    "check:recorder-retention": "node scripts/recorder-retention-check.mjs",
    "check:tick-owner": "node scripts/capture-tick-owner-check.mjs",
    "check:settings": "node scripts/settings-limits-check.mjs",
    "check:hotkeys": "node scripts/hotkey-registry-check.mjs",
    "check:about": "node scripts/about-window-check.mjs",
    "check:clipboard": "node scripts/clipboard-contract-check.mjs",
    "check:source-first-save": "node scripts/source-first-save-check.mjs",
    "check:background-media": "node scripts/background-media-queue-check.mjs",
    "check:chrome-lifecycle": "node scripts/chrome-lifecycle-check.mjs",
    "check:editor-lifecycle": "node scripts/editor-lifecycle-check.mjs",
    "check:editor-ux": "node scripts/editor-ux-contract-check.mjs",
    "check:qa-process-tree": "node scripts/process-tree-check.mjs",
    "check:pack-forensics": "node scripts/pack-forensics-check.mjs",
    "check:display-clock": "node scripts/display-clock-check.mjs",
    "check:temporal": "node test/temporal/check.mjs",
    "check:validator": "node ../tools/validate-capturepack-check.mjs",
    "check:spec": "node ../tools/validate-capturepack.mjs ../examples/minimal",
    "check:site": "node ../site/validate.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "qa:checks": "node scripts/qa-gate.mjs --skip-build",
    "qa:video": "node scripts/qa-gate.mjs --skip-build --profile video",
    "qa:pack": "node scripts/pack-forensics.mjs",
    "qa:rc": "node scripts/qa-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.3.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.14.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
