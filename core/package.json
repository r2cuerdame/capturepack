{
  "name": "capturepack",
  "productName": "CapturePack",
  "version": "0.2.0-rc.18",
  "description": "Capture context, not screenshots. The fastest way to explain something to an LLM.",
  "license": "MIT",
  "author": "r2cuerdame",
  "homepage": "https://github.com/r2cuerdame/capturepack",
  "repository": {
    "type": "git",
    "url": "https://github.com/r2cuerdame/capturepack.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
